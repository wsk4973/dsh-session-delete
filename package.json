{
  "name": "dsh-session-delete",
  "version": "1.0.0",
  "description": "DSH 会话删除插件：在会话行「...」菜单里一键彻底删除对话，连同磁盘上的会话日志一起清掉。Delete conversations from DeepSeek Harness — removes the row and wipes its log, registry entry and projection cache.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "delete"
  ],
  "license": "MIT",
  "author": "wsk4973",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsk4973/dsh-session-delete.git"
  },
  "homepage": "https://github.com/wsk4973/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/wsk4973/dsh-session-delete/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/smoke.mjs && node test/http.mjs && node test/client.mjs"
  }
}
